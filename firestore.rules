rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny everything not listed below
    match /{document=**} {
      allow read, write: if false;
    }

    // Only the Dasmariñas store document is accessible.
    // (No list, no delete, no wildcard store IDs, no open "test" collection.)
    match /store_state/dasmarinas {
      allow get: if true;
      allow create, update: if isValidStoreState(request.resource.data);
      allow delete: if false;
    }

    function isValidStoreState(data) {
      return data is map &&
        data.keys().hasOnly([
          'sales', 'tasks', 'leads', 'final', 'goal', 'pm',
          'mainPushTargets', 'mainPushVariants', 'mainPushDividers',
          'inventoryUnits', 'hasCustomInventory', 'updatedAt',
          'staff'
        ]) &&
        (!('goal' in data) || data.goal is number) &&
        (!('sales' in data) || (data.sales is list && data.sales.size() <= 20000)) &&
        (!('inventoryUnits' in data) || (data.inventoryUnits is list && data.inventoryUnits.size() <= 20000)) &&
        (!('hasCustomInventory' in data) || data.hasCustomInventory is bool) &&
        (!('staff' in data) || (data.staff is list && data.staff.size() <= 50));
    }
  }
}

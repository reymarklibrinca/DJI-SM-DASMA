function rl(){const el=$('#rlist'),grp={},gk=k=>grp[k]||(grp[k]={sales:[],leads:[],sa:0,un:0,l:[0,0,0]}),TN=['Walk-in','Revisit','Online'];
 L.sales.forEach((x,i)=>{const g=gk(x[1]);g.sales.unshift([i,x]);g.sa+=x[3];g.un+=x[4]??1});
 for(const d of Object.keys(L.leads))for(const sk in L.leads[d])[0,1,2].forEach(t=>{const n=L.leads[d][sk][t];if(n>0){const g=gk(sk);g.leads.push([+d,t,n,sk]);g.l[t]+=n}});
 const keys=Object.keys(grp).sort(),tot=keys.reduce((a,k)=>{a[0]+=grp[k].sales.length;a[1]+=grp[k].sa;a[2]+=grp[k].l[0]+grp[k].l[1]+grp[k].l[2];return a},[0,0,0]);
 el.innerHTML=keys.length?`<div class="mut" style="margin-bottom:8px">All promoters together: ${tot[0]} sale(s), ${M(tot[1])}, ${tot[2]} lead(s)</div>`+keys.map(k=>{const g=grp[k],nm=k=='u'?'Not tagged':ST[k];
  const ent=g.sales.map(([i,x])=>[x[0],`<tr><td>${fd(x[0])}</td><td>Sale</td><td>${SE[x[2]]}, ${M(x[3])}${x[6]?', SN '+x[6]:''}</td><td>${x[7]!==undefined?TN[x[7]]:'–'}</td><td>${L.final[x[0]]?'<span class="mut">Locked</span>':`<button data-ds="${i}">Delete</button>`}</td></tr>`]).concat(g.leads.map(x=>[x[0],`<tr><td>${fd(x[0])}</td><td>Lead</td><td>${x[2]} lead(s)</td><td>${TN[x[1]]}</td><td>${L.final[x[0]]?'<span class="mut">Locked</span>':`<button data-dl="${x[0]},${x[3]},${x[1]}">Remove 1</button>`}</td></tr>`])).sort((a,b)=>b[0]-a[0]).slice(0,10).map(z=>z[1]).join('');
  return `<div style="margin-bottom:16px"><div class="f" style="justify-content:space-between;align-items:baseline"><b style="font-size:16px">${nm}</b><span class="mut">${g.sales.length} sale(s), ${M(g.sa)} · Leads: ${g.l[0]} walk-in, ${g.l[1]} revisit, ${g.l[2]} online</span></div><div class="sc"><table style="min-width:0"><tr><th>Date</th><th>Type</th><th>Details</th><th>Lead</th><th></th></tr>${ent}</table></div></div>`}).join(''):'<div class="mut">Nothing added yet. Sales and leads you log appear here under each promoter, and you can delete them.</div>';
 el.querySelectorAll('[data-ds]').forEach(b=>b.onclick=()=>{L.sales.splice(+b.dataset.ds,1);S=D.sales.concat(L.sales);fixEnd();save();$('#qm').textContent='Sale deleted.';rl();view()});
 el.querySelectorAll('[data-dl]').forEach(b=>b.onclick=()=>{const[k,sk,t]=b.dataset.dl.split(','),l=L.leads[k],a=l[sk];a[+t]--;if(!a[0]&&!a[1]&&!a[2])delete l[sk];if(!Object.keys(l).length)delete L.leads[k];fixEnd();save();$('#qm').textContent='Lead removed.';rl();view()})}
$('#qsn').oninput=snFind;$('#qsn').onkeydown=e=>{if(e.key=='Enter')snFind()};$('#qsf').onclick=snFind;
function ll(){const i=Math.round((new Date($('#qd').value+'T00:00:00')-SD)/864e5);$('#ll').textContent='Log a lead for '+ST[+$('#qs').value]+(i>=0?' on '+fd(i):'')}
$('#qs').onchange=ll;$('#qd').onchange=ll;ll();
$('#qfin').onclick=finToggle;finBtn();
rl();bar();view();
</script></body></html>